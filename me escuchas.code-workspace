{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "files.encoding": "utf8",
    "editor.wordWrap": "on",
    "liveServer.settings.port": 5500
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Ver experiencia en local",
        "type": "process",
        "command": "python3",
        "args": [
          "-m",
          "http.server",
          "8000",
          "--bind",
          "127.0.0.1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ]
  }
}
